# Copy to terraform.tfvars (git-ignored) and adjust. No credentials belong here:
# Terraform reads them from your AWS CLI profile / environment.
aws_region         = "ap-south-1"
project            = "clinicflow"
environment        = "dev"
owner              = "ankit-kumar"
kubernetes_version = "1.34"

node_instance_types = ["t3.medium"]
node_capacity_type  = "ON_DEMAND" # "SPOT" for a cheaper demo
node_desired_size   = 3

github_repository  = "ankit14-dev/clinicflow"
github_environment = "production"
