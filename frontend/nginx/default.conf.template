# Rendered at container start by the nginx image (envsubst on /etc/nginx/templates/*.template).
# BACKEND_URL: http://backend:8000 in docker compose, http://<release>-backend:8000 in Kubernetes.
server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;
  server_tokens off;

  add_header X-Content-Type-Options nosniff always;
  add_header X-Frame-Options DENY always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;

  # hashed build assets can be cached for a year; index.html must always be revalidated.
  # (`expires`, not add_header: an add_header inside a location would drop the headers above)
  location /assets/ {
    expires 1y;
  }

  location / {
    expires -1;
    try_files $uri /index.html;
  }

  location /api/ {
    proxy_pass ${BACKEND_URL};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # the frontend's own liveness endpoint: does not depend on the backend
  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }
}
